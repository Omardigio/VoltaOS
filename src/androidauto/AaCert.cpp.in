// Generated by CMake from third_party/aap_cert/headunit.crt and headunit.key
#include "AaCert.h"
#include <QFile>
#include <QDir>

static const char kCert[] = R"PEM(@AA_CERT_PEM@)PEM";
static const char kKey[] = R"PEM(@AA_KEY_PEM@)PEM";

bool aaLoadCertificate(QByteArray *cert, QByteArray *key, const QString &dataDir, QString *error)
{
    QFile c(QDir(dataDir).filePath(QStringLiteral("headunit.crt")));
    QFile k(QDir(dataDir).filePath(QStringLiteral("headunit.key")));
    if (c.open(QIODevice::ReadOnly) && k.open(QIODevice::ReadOnly)) {      // user-supplied replacement
        *cert = c.readAll();
        *key = k.readAll();
        return !cert->isEmpty() && !key->isEmpty();
    }
    *cert = QByteArray(kCert);
    *key = QByteArray(kKey);
    if (cert->isEmpty() || key->isEmpty()) { if (error) *error = QStringLiteral("no head unit certificate"); return false; }
    return true;
}
